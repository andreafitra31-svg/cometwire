  <div id="toast-container" class="fixed top-4 right-4 z-50 space-y-2"></div>

  <script>
    const firebaseConfig = {
      apiKey: "AIzaSyCA2n4z78k2XoSWwRvSYIlUi9--SD_yW4M",
      authDomain: "cometwire.firebaseapp.com",
      projectId: "cometwire",
      storageBucket: "cometwire.firebasestorage.app",
      messagingSenderId: "847211062831",
      appId: "1:847211062831:web:02d75de59440978a7a48da",
      measurementId: "G-NLRWXNVVH6"
    };

    let db = null;
    try {
      firebase.initializeApp(firebaseConfig);
      db = firebase.firestore();
    } catch (e) {
      console.error(e);
    }

    const dataService = {
      _data: [],
      _listeners: [],
      subscribe(fn) { this._listeners.push(fn); },
      _notify() { this._listeners.forEach(fn => fn(this._data)); },
      async init() {
        if (!db) {
          showToast('Firebase gagal diinisialisasi', 'error');
          return;
        }
        db.collection('records').onSnapshot((snapshot) => {
          this._data = snapshot.docs.map(doc => ({ __backendId: doc.id, ...doc.data() }));
          this._notify();
        }, () => showToast('Gagal memuat data Firebase', 'error'));
      },
      getAll() { return this._data; },
      getByType(type) { return this._data.filter(d => d.type === type); },
      async create(record) {
        try { if (!db) return false; await db.collection('records').add(record); return true; } catch { showToast('Gagal menyimpan data', 'error'); return false; }
      },
      async update(record) {
        try { if (!db) return false; const id = record.__backendId; delete record.__backendId; await db.collection('records').doc(id).set(record); return true; } catch { showToast('Gagal memperbarui data', 'error'); return false; }
      },
      async delete(record) {
        try { if (!db) return false; await db.collection('records').doc(record.__backendId).delete(); return true; } catch { showToast('Gagal menghapus data', 'error'); return false; }
      },
      getSettings() { return this.getByType('settings'); },
      getAdditions() { return this.getByType('addition'); },
      getUsages() { return this.getByType('usage'); },
      getAdjustments() { return this.getByType('adjustment'); },
      getItemSetting(item, size, status) {
        return this.getSettings().find(s => s.item_name === item && s.size === size && s.status === status);
      },
      computeStock(item, size, status) {
        const adds = this.getAdditions().filter(d => d.item_name === item && d.size === size && d.status === status);
        const uses = this.getUsages().filter(d => d.item_name === item && d.size === size && d.status === status);
        const adjs = this.getAdjustments().filter(d => d.item_name === item && d.size === size && d.status === status);
        return adds.reduce((s, d) => s + (d.quantity || 0), 0) - uses.reduce((s, d) => s + (d.quantity || 0), 0) + adjs.reduce((s, d) => s + (d.quantity || 0), 0);
      },
      getUniqueItems() {
        const map = new Map();
        this._data.forEach(d => {
          if (d.item_name && d.size && d.status && d.type !== 'settings') map.set(`${d.item_name}|${d.size}|${d.status}`, { item_name: d.item_name, size: d.size, status: d.status });
        });
        this.getSettings().forEach(d => map.set(`${d.item_name}|${d.size}|${d.status}`, { item_name: d.item_name, size: d.size, status: d.status }));
        return [...map.values()];
      },
      getUsageInPeriod(item, size, status, startDate, endDate) {
        return this.getUsages().filter(d => d.item_name === item && d.size === size && d.status === status && (d.date || '') >= startDate && (d.date || '') <= endDate).reduce((s, d) => s + (d.quantity || 0), 0);
      },
      getAdditionsInPeriod(startDate, endDate) {
        return this.getAdditions().filter(d => (d.date || '') >= startDate && (d.date || '') <= endDate).reduce((s, d) => s + (d.quantity || 0), 0);
      },
      getUsagesInPeriod(startDate, endDate) {
        return this.getUsages().filter(d => (d.date || '') >= startDate && (d.date || '') <= endDate).reduce((s, d) => s + (d.quantity || 0), 0);
      }
    };

    let currentPage = 'dashboard';

    function showToast(msg, type = 'success') {
      const container = document.getElementById('toast-container');
      const el = document.createElement('div');
      el.className = `toast text-sm px-4 py-3 rounded-lg shadow-lg font-medium ${type === 'error' ? 'bg-red-600 text-white' : 'bg-green-600 text-white'}`;
      el.textContent = msg;
      container.appendChild(el);
      setTimeout(() => el.remove(), 3000);
    }

    function navigateTo(page) {
      document.querySelectorAll('.page-section').forEach(s => s.classList.add('hidden'));
      const target = document.getElementById('page-' + page);
      if (target) target.classList.remove('hidden');
      document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
      const navBtn = document.querySelector(`[data-page="${page}"]`);
      if (navBtn) navBtn.classList.add('active');
      currentPage = page;
      renderPage();
      document.getElementById('sidebar').classList.remove('open');
    }

    function renderPage() {
      if (currentPage === 'dashboard') renderDashboard();
      if (currentPage === 'stock') renderStockPage();
      if (currentPage === 'history-usage') renderHistoryUsage();
      if (currentPage === 'history-add') renderHistoryAdd();
      if (currentPage === 'reports') renderReports();
      if (currentPage === 'settings') renderSettings();
    }

    function getFilterDates() {
      const period = document.getElementById('filter-period').value;
      const now = new Date();
      let start, end;
      const fmt = d => d.toISOString().slice(0, 10);
      if (period === 'today') { start = end = fmt(now); }
      else if (period === 'month') { start = fmt(new Date(now.getFullYear(), now.getMonth(), 1)); end = fmt(new Date(now.getFullYear(), now.getMonth() + 1, 0)); }
      else if (period === 'year') { start = fmt(new Date(now.getFullYear(), 0, 1)); end = fmt(new Date(now.getFullYear(), 11, 31)); }
      else { start = document.getElementById('filter-start').value || fmt(new Date(now.getFullYear(), now.getMonth(), 1)); end = document.getElementById('filter-end').value || fmt(now); }
      return { start, end };
    }

    function renderDashboard() {
      const items = dataService.getUniqueItems();
      const { start, end } = getFilterDates();
      let totalNew = 0, totalReuse = 0;
      items.forEach(it => {
        const stock = dataService.computeStock(it.item_name, it.size, it.status);
        if (it.status === 'NEW') totalNew += stock; else totalReuse += stock;
      });
      document.getElementById('stat-total').textContent = totalNew + totalReuse;
      document.getElementById('stat-new').textContent = totalNew;
      document.getElementById('stat-reuse').textContent = totalReuse;
      const totalAdds = dataService.getAdditionsInPeriod(start, end);
      const totalUses = dataService.getUsagesInPeriod(start, end);
      document.getElementById('stat-additions').textContent = '+' + totalAdds;
      document.getElementById('stat-usage').textContent = '-' + totalUses;
      const totalTarget = dataService.getSettings().reduce((s, d) => s + (d.target_usage || 0), 0);
      const pct = totalTarget > 0 ? Math.round((totalUses / totalTarget) * 100) : 0;
      document.getElementById('stat-percent').textContent = pct + '%';
      document.getElementById('progress-percent').style.width = Math.min(pct, 100) + '%';

      const ac = document.getElementById('alerts-container');
      ac.innerHTML = '<div class="text-sm text-green-600 bg-green-50 rounded-lg px-4 py-3">🟢 Tidak ada peringatan saat ini.</div>';

      const tbody = document.getElementById('monitoring-table');
      tbody.innerHTML = items.map(it => {
        const stock = dataService.computeStock(it.item_name, it.size, it.status);
        const setting = dataService.getItemSetting(it.item_name, it.size, it.status);
        const minStock = setting ? setting.min_stock || 0 : 0;
        const targetUsage = setting ? setting.target_usage || 0 : 0;
        const usage = dataService.getUsageInPeriod(it.item_name, it.size, it.status, start, end);
        const pctItem = targetUsage > 0 ? Math.round((usage / targetUsage) * 100) : 0;
        return `<tr><td class="px-4 py-3">${it.item_name}</td><td class="px-4 py-3">${it.size}</td><td class="px-4 py-3">${it.status}</td><td class="px-4 py-3 text-right font-bold">${stock}</td><td class="px-4 py-3 text-right">${minStock}</td><td class="px-4 py-3 text-right">${usage}</td><td class="px-4 py-3 text-right">${targetUsage}</td><td class="px-4 py-3 text-right">${pctItem}%</td><td class="px-4 py-3 text-center">${stock <= minStock ? '🔴 Alert' : '🟢 Aman'}</td></tr>`;
      }).join('');
    }

    function renderStockPage() {
      const tbody = document.getElementById('table-stock');
      const items = dataService.getUniqueItems();
      tbody.innerHTML = items.map(it => {
        const stock = dataService.computeStock(it.item_name, it.size, it.status);
        const setting = dataService.getItemSetting(it.item_name, it.size, it.status);
        return `<tr><td class="px-4 py-3">${it.item_name}</td><td class="px-4 py-3">${it.size}</td><td class="px-4 py-3">${it.status}</td><td class="px-4 py-3 text-right">${stock}</td><td class="px-4 py-3 text-right">${setting?.target_stock || 0}</td><td class="px-4 py-3 text-right">${setting?.min_stock || 0}</td><td class="px-4 py-3 text-center">${stock <= (setting?.min_stock || 0) ? '🔴 Kritis' : '🟢 Aman'}</td></tr>`;
      }).join('');
    }

    function renderHistoryUsage() {
      const tbody = document.getElementById('table-history-usage');
      const data = dataService.getUsages().sort((a, b) => (b.date || '').localeCompare(a.date || ''));
      tbody.innerHTML = data.map(d => `<tr><td class="px-4 py-3">${d.date || ''}</td><td class="px-4 py-3">${d.item_name || ''}</td><td class="px-4 py-3">${d.size || ''}</td><td class="px-4 py-3">${d.status || ''}</td><td class="px-4 py-3 text-right">${d.quantity || 0}</td><td class="px-4 py-3">${d.procedure_type || ''}</td></tr>`).join('');
    }

    function renderHistoryAdd() {
      const tbody = document.getElementById('table-history-add');
      const data = dataService.getAdditions().sort((a, b) => (b.date || '').localeCompare(a.date || ''));
      tbody.innerHTML = data.map(d => `<tr><td class="px-4 py-3">${d.date || ''}</td><td class="px-4 py-3">${d.item_name || ''}</td><td class="px-4 py-3">${d.size || ''}</td><td class="px-4 py-3">${d.status || ''}</td><td class="px-4 py-3 text-right">${d.quantity || 0}</td><td class="px-4 py-3">${d.source || ''}</td></tr>`).join('');
    }

    function renderReports() {
      const tbody = document.getElementById('table-monthly');
      const now = new Date();
      const year = now.getFullYear();
      const months = ['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agu','Sep','Okt','Nov','Des'];
      const totalTarget = dataService.getSettings().reduce((s, d) => s + (d.target_usage || 0), 0);
      tbody.innerHTML = months.map((m, i) => {
        const start = `${year}-${String(i + 1).padStart(2, '0')}-01`;
        const end = `${year}-${String(i + 1).padStart(2, '0')}-${new Date(year, i + 1, 0).getDate()}`;
        const usage = dataService.getUsagesInPeriod(start, end);
        const pct = totalTarget > 0 ? Math.round((usage / totalTarget) * 100) : 0;
        return `<tr><td class="px-4 py-2">${m}</td><td class="px-4 py-2 text-right">${totalTarget}</td><td class="px-4 py-2 text-right">${usage}</td><td class="px-4 py-2 text-right">${pct}%</td><td class="px-4 py-2 text-center">${pct >= 100 ? 'Tercapai' : 'Aman'}</td></tr>`;
      }).join('');
    }

    function renderSettings() {
      const tbody = document.getElementById('table-settings');
      if (!tbody) return;
      tbody.innerHTML = '<tr><td class="px-4 py-6 text-center text-gray-400" colspan="8">Belum ada pengaturan</td></tr>';
    }

    document.getElementById('nav-menu').addEventListener('click', e => {
      const btn = e.target.closest('[data-page]');
      if (btn) navigateTo(btn.dataset.page);
    });
    document.getElementById('menu-toggle')?.addEventListener('click', () => document.getElementById('sidebar').classList.toggle('open'));
    document.getElementById('filter-period').addEventListener('change', function() {
      document.getElementById('custom-date-range').classList.toggle('hidden', this.value !== 'custom');
      renderDashboard();
    });

    function setDefaultDate() {
      const today = new Date().toISOString().slice(0, 10);
      document.getElementById('add-date').value = today;
      document.getElementById('use-date').value = today;
    }

    document.getElementById('form-add-stock').addEventListener('submit', async function(e) {
      e.preventDefault();
      const ok = await dataService.create({
        type: 'addition',
        item_name: document.getElementById('add-item').value,
        size: document.getElementById('add-size').value,
        status: document.getElementById('add-status').value,
        quantity: parseInt(document.getElementById('add-qty').value),
        date: document.getElementById('add-date').value,
        source: document.getElementById('add-source').value,
        notes: document.getElementById('add-notes').value
      });
      if (ok) { showToast('Stok berhasil ditambahkan'); this.reset(); setDefaultDate(); }
    });

    document.getElementById('form-usage').addEventListener('submit', async function(e) {
      e.preventDefault();
      const item = document.getElementById('use-item').value;
      const size = document.getElementById('use-size').value;
      const status = document.getElementById('use-status').value;
      const qty = parseInt(document.getElementById('use-qty').value);
      if (qty > dataService.computeStock(item, size, status)) { showToast('Stok tidak mencukupi.', 'error'); return; }
      const ok = await dataService.create({
        type: 'usage',
        item_name: item,
        size,
        status,
        quantity: qty,
        date: document.getElementById('use-date').value,
        room: document.getElementById('use-room').value,
        procedure_type: document.getElementById('use-procedure').value,
        notes: document.getElementById('use-notes').value
      });
      if (ok) { showToast('Pemakaian berhasil dicatat'); this.reset(); setDefaultDate(); }
    });

    document.getElementById('form-settings').addEventListener('submit', async function(e) {
      e.preventDefault();
      const ok = await dataService.create({
        type: 'settings',
        item_name: document.getElementById('set-item').value,
        size: document.getElementById('set-size').value,
        status: document.getElementById('set-status').value,
        target_stock: parseInt(document.getElementById('set-target-stock').value),
        min_stock: parseInt(document.getElementById('set-min-stock').value),
        target_usage: parseInt(document.getElementById('set-target-usage').value),
        notes: document.getElementById('set-buffer').value
      });
      if (ok) { showToast('Pengaturan disimpan'); this.reset(); }
    });

    async function init() {
      setDefaultDate();
      dataService.subscribe(() => renderPage());
      await dataService.init();
    }

    init();
  </script>
</body>
</html>
